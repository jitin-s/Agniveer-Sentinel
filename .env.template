# ==============================================================================
# AGNIVEER SENTINEL CONFIGURATION ENVIRONMENT VARIABLES
# Rename this file to '.env' and enter your respective keys.
# ==============================================================================

# LLM Providers Configuration (Set at least one) choose any one
# ----------------------------------------------

# Google Gemini API Config. (Default) 
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI ChatGPT Config.
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude Config.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Active LLM Provider Selection: Choose from 'gemini', 'openai', 'anthropic', or 'local'
ACTIVE_PROVIDER=gemini
